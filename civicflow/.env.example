# Copy this file to .env and paste your key after AI_API_KEY=.
# Keep .env private; it is excluded from Git.

# Optional. With a key, reports are assessed by an OpenAI-compatible model; without one, the labelled rules fallback runs.
AI_API_KEY=your_openai_api_key_here
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini

# SQLite file and uploaded-photo folder. Point both at a persistent disk when deploying.
DATABASE_PATH=./civicflow.db
UPLOAD_DIR=./uploads

# Port used when running `python app.py` (default 8000).
PORT=8000
